# Copy to .env (never commit .env) and fill in.

# Required: the studio's password
MYTOMA_PASSWORD=change-me

# Where projects live on this computer (Claude edits them here)
MYTOMA_PROJECTS_DIR=/home/you/mytoma/projects

# Your recordings folder, mounted read-only
MYTOMA_RECORDINGS=/home/you/Videos

# Which address to listen on: your Tailscale IP (tailscale ip -4) to reach it from your other devices,
# or 127.0.0.1 for this computer only
MYTOMA_BIND=127.0.0.1

# 1 to build with the CUDA libraries (use with docker-compose.gpu.yml)
MYTOMA_GPU=0
